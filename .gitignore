# Environment files (NEVER commit real values)
.Renviron
.Renviron.prod
.Renviron.test
.env
*.env

# Keep the example template
!.Renviron.example

# R artifacts
.Rhistory
.Rapp.history
.RData
.RDataTmp
.Rproj.user/
.Ruserdata
/*.Rcheck/
*-Ex.R
rsconnect/

# SSMS / Visual Studio user files
.vs/
*.ssmssln
*.ssmssqlproj
*.suo
*.user

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Output files from R CMD build
/*.tar.gz

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# pkgdown site
docs/

# translation temp files
po/*~

